# Sudoers configuration for SHSM (Server Health & Security Monitoring)
# Allows user 'shsm' to run strictly read-only diagnostics and non-root WP-CLI switches.
# Place in /etc/sudoers.d/shsm and ensure 0440 permissions.

# 1. Systemctl status / is-active / show / list-units checks (strictly read-only)
shsm ALL=(ALL) NOPASSWD: /bin/systemctl status *, /bin/systemctl is-active *, /bin/systemctl show *, /bin/systemctl list-units *, /usr/bin/systemctl status *, /usr/bin/systemctl is-active *, /usr/bin/systemctl show *, /usr/bin/systemctl list-units *

# 2. Journalctl log reading (strictly read-only)
shsm ALL=(ALL) NOPASSWD: /bin/journalctl *

# 3. Security scanners & auditing tools
shsm ALL=(ALL) NOPASSWD: /usr/bin/lynis audit system *
shsm ALL=(ALL) NOPASSWD: /usr/bin/rkhunter --check *
shsm ALL=(ALL) NOPASSWD: /usr/bin/chkrootkit *
shsm ALL=(ALL) NOPASSWD: /usr/bin/clamscan *, /usr/bin/clamdscan *

# 4. Firewall inspection & auto-drop (strictly limited to banning abusive IPs)
shsm ALL=(ALL) NOPASSWD: /usr/sbin/ufw status *, /usr/bin/ufw status *
shsm ALL=(ALL) NOPASSWD: /usr/sbin/csf -l, /usr/bin/csf -l, /usr/sbin/csf -d *, /usr/sbin/csf -dr *
shsm ALL=(ALL) NOPASSWD: /usr/sbin/nft list ruleset, /usr/bin/nft list ruleset
shsm ALL=(ALL) NOPASSWD: /usr/sbin/iptables -L *, /sbin/iptables -L *, /usr/bin/iptables -L *
shsm ALL=(ALL) NOPASSWD: /usr/sbin/iptables -C *, /sbin/iptables -C *, /usr/bin/iptables -C *
shsm ALL=(ALL) NOPASSWD: /usr/sbin/iptables -I INPUT -s * -j DROP, /sbin/iptables -I INPUT -s * -j DROP, /usr/bin/iptables -I INPUT -s * -j DROP
shsm ALL=(ALL) NOPASSWD: /usr/sbin/iptables -D INPUT -s * -j DROP, /sbin/iptables -D INPUT -s * -j DROP, /usr/bin/iptables -D INPUT -s * -j DROP
shsm ALL=(ALL) NOPASSWD: /usr/sbin/ip6tables -L *, /sbin/ip6tables -L *, /usr/bin/ip6tables -L *
shsm ALL=(ALL) NOPASSWD: /usr/bin/firewall-cmd --state, /usr/bin/firewall-cmd --list-all *

# 5. Fail2ban status & IP ban management
shsm ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client status, /usr/bin/fail2ban-client status *, /usr/bin/fail2ban-client set * banip *, /usr/bin/fail2ban-client set * unbanip *, /usr/bin/fail2ban-client unban *, /bin/fail2ban-client status, /bin/fail2ban-client status *, /bin/fail2ban-client set * banip *, /bin/fail2ban-client set * unbanip *, /bin/fail2ban-client unban *

# 6. Least-privilege WP-CLI invocation as site owner (never as root!)
# Allows shsm to run wp-cli as any website user (e.g. sudo -u user123 wp ...)
shsm ALL=(ALL) NOPASSWD: /usr/local/bin/wp *, /usr/bin/wp *
