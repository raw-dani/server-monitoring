[Unit]
Description=SHSM CyberPanel website discovery
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml websites discover
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
