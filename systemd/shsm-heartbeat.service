[Unit]
Description=SHSM External heartbeat
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml external send
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
CPUQuota=40%
MemoryHigh=192M
MemoryMax=256M
