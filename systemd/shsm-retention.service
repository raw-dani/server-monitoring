[Unit]
Description=SHSM Rollups and retention
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml retention run
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
