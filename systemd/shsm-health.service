[Unit]
Description=SHSM CPU/RAM/swap/disk/network/process metrics
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=shsm
Group=shsm
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml collect health
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
