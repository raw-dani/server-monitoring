[Unit]
Description=SHSM Postfix queue & unauthorized outbound SMTP checks
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml collect mail
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=20%
MemoryHigh=192M
MemoryMax=256M
IOWeight=100
