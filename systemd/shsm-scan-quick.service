[Unit]
Description=SHSM Daily heuristic + ClamAV quick scan
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml security scan --profile quick --only heuristic,clamav
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
