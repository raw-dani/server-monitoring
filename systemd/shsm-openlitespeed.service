[Unit]
Description=SHSM OpenLiteSpeed log parsing
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml collect openlitespeed
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
Nice=-2
IOSchedulingClass=best-effort
IOSchedulingPriority=4
CPUQuota=25%
MemoryHigh=128M
MemoryMax=192M
IOWeight=150
