[Unit]
Description=SHSM DDoS socket flood & concurrent connection audit
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=shsm
Group=shsm
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml collect ddos
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=20%
MemoryHigh=192M
MemoryMax=256M
IOWeight=100
