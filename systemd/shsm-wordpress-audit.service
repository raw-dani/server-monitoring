[Unit]
Description=SHSM WordPress core/plugin/theme/user audit
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml wordpress audit
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUQuota=15%
MemoryHigh=256M
MemoryMax=384M
IOWeight=50
