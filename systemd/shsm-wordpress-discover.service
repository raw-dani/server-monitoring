[Unit]
Description=SHSM WordPress installation discovery
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml wordpress discover
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
