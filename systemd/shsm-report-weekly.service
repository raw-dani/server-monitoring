[Unit]
Description=SHSM Weekly HTML/PDF report
Documentation=https://github.com/gmteknologi/shsm
After=network.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/shsm/venv/bin/shsm --config /etc/shsm/config.yaml report weekly --send
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
